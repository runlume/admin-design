{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true
  },
  "include": [".vitepress/**/*.ts", ".vitepress/**/*.vue"]
}
