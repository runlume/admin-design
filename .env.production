# 生产构建默认值。机器专用覆盖写入 .env.production.local（已被忽略）。

# 浏览器标题：也是微信这类渠道分享卡片取的标题，要带上站点角色词
VITE_APP_TITLE=Runlume 标准后台设计 · 在线演示
VITE_APP_STORAGE_PREFIX=runlume.
VITE_APP_API_BASEURL=/
VITE_APP_PLATFORM_WEB_BASEURL=https://runlume.app
VITE_APP_DISABLE_DEVTOOL=false

# 访问统计（可选）：填 GoatCounter 之类的计数端点才会加载统计脚本，留空完全不加载
VITE_APP_ANALYTICS_URL=

# ===== 以下配置只在构建时生效 =====

# 产出 sourcemap；需要线上排障时改成 true 再发一版
VITE_BUILD_SOURCEMAP=false

# 预压缩产物，支持 gzip、brotli，逗号分隔；留空表示不压缩
VITE_BUILD_COMPRESS=
