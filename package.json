{
  "name": "@runlume/admin-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Runlume 标准后台基础组件、主题与语义 Token",
  "license": "Apache-2.0",
  "files": [
    "dist-package",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist-package/admin-ui.d.ts",
      "import": "./dist-package/index.js"
    },
    "./styles.css": "./dist-package/styles.css"
  },
  "types": "./dist-package/admin-ui.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runlume/admin-design.git"
  },
  "homepage": "https://github.com/runlume/admin-design#readme",
  "bugs": {
    "url": "https://github.com/runlume/admin-design/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepack": "pnpm build:lib",
    "build:test": "tsc -b && vite build --mode test",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && node scripts/build-llms.mjs",
    "docs:preview": "vitepress preview docs --port 3211",
    "site:build": "node scripts/build-site.mjs",
    "site:preview": "python3 -m http.server -d _site 3299",
    "format": "prettier --write src docs site README.md README.en.md AGENTS.md vite.config.ts playwright.config.ts",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "format:check": "prettier --check src docs site README.md README.en.md AGENTS.md vite.config.ts playwright.config.ts",
    "verify": "pnpm check && pnpm test:e2e",
    "screenshots": "SCREENSHOTS=1 pnpm test:e2e -- --output=/tmp/pw-admin-out"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.44.0",
    "pinyin-pro": "3.28.1",
    "radix-ui": "1.6.7",
    "react-hook-form": "7.87.0",
    "react-router": "7.18.3",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "30.0.1",
    "oxlint": "^1.81.0",
    "prettier": "3.9.6",
    "i18next": "26.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "17.0.13",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitepress": "^1.6.4",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "i18next": "^26.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  }
}
