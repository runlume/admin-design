# 本地开发默认值。机器专用覆盖写入 .env.development.local（已被忽略）。

# 浏览器标题后缀
VITE_APP_TITLE=Runlume 标准后台设计

# localStorage / sessionStorage 前缀，业务系统务必改成自己的
VITE_APP_STORAGE_PREFIX=runlume_dev.

# 接口基地址（模板未使用，留给业务接入）
VITE_APP_API_BASEURL=/

# 平台 / 官网地址：终端横幅、控制台品牌输出与侧栏底部外链都读它
VITE_APP_PLATFORM_WEB_BASEURL=https://runlume.app

# 禁用浏览器开发者工具（F12 / 右键 / 快捷键）；只挡随手打开，挡不住有心人
VITE_APP_DISABLE_DEVTOOL=false

# 访问统计（可选）：本地开发默认不加载统计脚本
VITE_APP_ANALYTICS_URL=
